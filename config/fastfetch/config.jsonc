{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "chafa",
    "source": "/home/specter/Pictures/Wallkitty/Neofetch.png",
    "width": 15,
    "padding": {
      "top": 1,
      "right": 4
    }
  },
  "display": {
      "separator": "  ➜  ",
      "color": "blue"
  },
  "modules": [
    "break",
    {
        "type": "title",
        "key": " User",
        "format": "{user-name}",
        "keyColor": "red"
    },
    {
        "type": "title",  // <-- ВАЖНО: Используем TITLE, а не HOST
        "key": " PC  ",
        "format": "{host-name}", // Теперь переменная сработает и покажет Aurora
        "keyColor": "red"
    },
    "break",
    {
        "type": "os",
        "key": " OS  ",
        "keyColor": "blue"
    },
    {
        "type": "kernel",
        "key": " Ver ",
        "keyColor": "white"
    },
    {
        "type": "uptime",
        "key": " Up  ",
        "keyColor": "yellow"
    },
    {
        "type": "packages",
        "key": " Pkgs",
        "keyColor": "magenta"
    },
    "break",
    {
        "type": "wm",
        "key": " WM  ",
        "keyColor": "blue"
    },
    {
        "type": "terminal",
        "key": " Term",
        "keyColor": "green"
    },
    "break",
    {
        "type": "cpu",
        "key": " CPU ",
        "keyColor": "green"
    },
    {
        "type": "memory",
        "key": " RAM ",
        "keyColor": "yellow"
    },
    "break",
    "colors"
  ]
}
