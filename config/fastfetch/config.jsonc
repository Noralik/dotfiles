{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "/home/specter/Pictures/Wallkitty/Neofetsh.png", 
    "width": 32,
    "height": 18,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
      "separator": "   ",
      "color": "blue"
  },
  "modules": [
    "break",
    {
        "type": "title",
        "keyWidth": 10
    },
    "break",
    {
        "type": "os",
        "key": " OS",
        "keyColor": "blue"
    },
    {
        "type": "kernel",
        "key": " Ver",
        "keyColor": "white"
    },
    {
        "type": "uptime",
        "key": " Up",
        "keyColor": "yellow"
    },
    {
        "type": "packages",
        "key": " Pkgs",
        "keyColor": "magenta"
    },
    {
        "type": "wm",
        "key": " WM",
        "keyColor": "blue"
    },
    {
        "type": "terminal",
        "key": " Term",
        "keyColor": "red"
    },
    {
        "type": "cpu",
        "key": " CPU",
        "keyColor": "green"
    },
    {
        "type": "memory",
        "key": " RAM",
        "keyColor": "yellow"
    },
    "break",
    "colors"
  ]
}
